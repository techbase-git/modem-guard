[Unit]
Description=Modem recovery decision point
Documentation=file:/etc/modem.conf
After=ModemManager.service NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/modem-guard
# Bounds the run. Two ping targets at one packet and a 3 s timeout each is
# the worst case, so this leaves plenty of room.
TimeoutStartSec=60
